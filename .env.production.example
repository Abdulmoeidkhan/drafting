APP_NAME="Participant Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=participant_management
DB_USERNAME=participant_management
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

MARIADB_DATABASE=participant_management
MARIADB_USER=participant_management
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=example.com

BROADCAST_CONNECTION=reverb
BROADCAST_QUEUE_CONNECTION=database
BROADCAST_QUEUE=broadcasts

REVERB_APP_ID=participant-management
REVERB_APP_KEY=change-reverb-key
REVERB_APP_SECRET=change-reverb-secret
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_PORT=8080

VITE_REVERB_APP_KEY=change-reverb-key
VITE_REVERB_HOST=example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="Participant Management System"
